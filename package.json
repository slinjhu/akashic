{
  "name": "akashic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "publish": "node scripts/publish.mjs",
    "typecheck": "npm run content && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "chokidar": "^4.0.3",
    "typescript": "^5.9.3"
  }
}
